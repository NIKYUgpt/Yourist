# Скопируйте в .env и задайте свои значения. .env в git не попадает.

# dev | test | prod
ENV=dev
# В prod — случайная строка от 32 символов:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# База данных (docker compose)
POSTGRES_DB=yourist
POSTGRES_USER=yourist
POSTGRES_PASSWORD=yourist
# Для запуска backend на хосте; внутри compose адрес подставляется автоматически
DATABASE_URL=postgresql+asyncpg://yourist:yourist@127.0.0.1:5432/yourist

# Адрес клиента — используется в ссылках из писем
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Почта: console — письма в лог, smtp — реальная отправка
MAIL_BACKEND=console
MAIL_FROM=Yourist <no-reply@nikyu.ru>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=true

# Сервис корпуса законов
CORPUS_SYNC_ENABLED=true
CORPUS_SYNC_INTERVAL_HOURS=24
# пауза между запросами к pravo.gov.ru, сек — не нагружаем госпортал
CORPUS_REQUEST_DELAY_SEC=1.0

# ─── Нейросети ───────────────────────────────────────────────────────────────
# Какая модель решает какую задачу и переключатель local/api — в админке
# (/api/v1/admin/ai). Здесь только адреса и ключи; пустой ключ — провайдер выключен.

# Локальные модели (Ollama). Из docker-контейнеров используется OLLAMA_DOCKER_URL
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_DOCKER_URL=http://host.docker.internal:11434
OLLAMA_NUM_CTX=8192

# YandexGPT: API-ключ сервисного аккаунта и идентификатор каталога
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# GigaChat: «Ключ авторизации» из личного кабинета (Base64)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# сертификат НУЦ Минцифры (https://www.gosuslugi.ru/crt), если TLS-проверка не проходит
GIGACHAT_CA_BUNDLE=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Alibaba Cloud Model Studio (DashScope)
QWEN_API_KEY=

# Прокси для зарубежных API, недоступных из РФ напрямую (http://… или socks5://…)
AI_PROXY_URL=
AI_PROXY_PROVIDERS=["openai","anthropic","gemini"]

# Сервис обезличивания. В compose адрес задаётся сам (http://deid:8002);
# пусто — api обезличивает в своём процессе (для разработки)
DEID_URL=

# Поисковый индекс (строится сервисом corpus): после синхронизации и по таймеру
CORPUS_INDEX_ENABLED=true
CORPUS_INDEX_INTERVAL_MINUTES=10
