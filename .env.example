# Скопируйте в .env и задайте свои значения. .env в git не попадает.

# dev | test | prod
ENV=dev
# В prod — случайная строка от 32 символов:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# База данных (docker compose)
POSTGRES_DB=yourist
POSTGRES_USER=yourist
POSTGRES_PASSWORD=yourist
# Для запуска backend на хосте; внутри compose адрес подставляется автоматически
DATABASE_URL=postgresql+asyncpg://yourist:yourist@127.0.0.1:5432/yourist

# Адрес клиента — используется в ссылках из писем
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Почта: console — письма в лог, smtp — реальная отправка
MAIL_BACKEND=console
MAIL_FROM=Yourist <no-reply@nikyu.ru>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=true

# Сервис корпуса законов
CORPUS_SYNC_ENABLED=true
CORPUS_SYNC_INTERVAL_HOURS=24
# пауза между запросами к pravo.gov.ru, сек — не нагружаем госпортал
CORPUS_REQUEST_DELAY_SEC=1.0
